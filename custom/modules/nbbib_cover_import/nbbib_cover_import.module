<?php

use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\File\FileSystemInterface;
use Drupal\file\Entity\File;
use Drupal\media\Entity\Media;

/**
 * @file
 * Contains nbbib_cover_import.module.php
 */

/**
 * Implements hook_entity_view().
 */
function nbbib_cover_import_entity_view(&$build, $entity, $display, $view_mode) {

  if ($entity->bundle() == 'yabrm_book') {
    $cover_id = $entity->getCover()[0]['target_id'] ?? 0;
    $missing = $entity->getCoverMissing();
    $month = intval(date('m'));
    $isbn_in = $entity->getIsbn() ?? NULL;

    // If no ISBN, existing cover or missing cover known for less than a month, return.
    if ((!$isbn_in) or ($cover_id > 0) or ($missing and ($month == $missing))) {
      return;
    }
    
    // Otherwise, process ISBN.
    $isbn_in = str_replace('-', '', $isbn_in);
    $isnb_found = '';
    $matches = filter_isbn($isbn_in);
    
    // If valid ISBNs found...
    if (!empty($matches)) {
      foreach ($matches as $isbn) {
        $isbn_found = $isbn;
        // Google Books:
        // Query the Google Books API
        $api_url = "https://www.googleapis.com/books/v1/volumes?q=isbn:" . urlencode($isbn);
        $response = file_get_contents($api_url);
        
        if ($response === FALSE) {
          \Drupal::logger('nbbib_cover_import')->notice("Error fetching data from Google Books API");
        }
        
        $data = json_decode($response, true);
        
        // Check if a book was found
        if (empty($data['items'][0]['volumeInfo']['imageLinks'])) {
          $gb_url = null;
        } 
        else {
          $images = $data['items'][0]['volumeInfo']['imageLinks'];
          // Order of preference, from largest to smallest
          $sizes = ['extraLarge', 'large', 'medium', 'small', 'thumbnail'];
          $gb_url = null;
          
          foreach ($sizes as $size) {
            if (!empty($images[$size])) {
              $gb_url = $images[$size];
              \Drupal::logger('nbbib_cover_import')->notice("Retrieved cover URL from Google Books API: $gb_url");
              break;
            }
          }
        }
        // Prepare import URL, directory, file, and URI. Use Google Books as fallback.
        $ol_url = "https://covers.openlibrary.org/b/isbn/{$isbn}-L.jpg";
        \Drupal::logger('nbbib_cover_import')->notice("Generated cover URL for Open Library API: $ol_url");
        $directory = 'public://book_covers';
        \Drupal::service('file_system')->prepareDirectory($directory, FileSystemInterface::CREATE_DIRECTORY | FileSystemInterface::MODIFY_PERMISSIONS);
        $filename = "book_cover_{$isbn}.jpg";
        $uri = "{$directory}/{$filename}";
        
        if (file_exists($uri)) {
          // File exists, load it by URI.
          $files = \Drupal::entityTypeManager()
            ->getStorage('file')
            ->loadByProperties(['uri' => $uri]);
          $file = reset($files);
          
          if ($file) {
            // Reference the existing file in the cover_image field.
            $entity->set('cover_image', [
              'target_id' => $file->id(),
              'alt' => 'Cover image for ISBN ' . $isbn,
            ]);

            save_reference($entity, $build);
          }
        }
        else {
          // Download the image.
          $gb_contents = $gb_url ? file_get_contents($gb_url) : '';
          $ol_contents = file_get_contents($ol_url);
        
          $contents = [
            'gb' => strlen($gb_contents), 
            'ol' => strlen($ol_contents),
          ];

          $best = array_keys($contents, max($contents))[0];
          
          switch ($best) {
            case 'gb':
              $image_contents = $gb_contents;
              $cover_url = $gb_url;
            break;
                
            default:
              $image_contents = $ol_contents;
              $cover_url = $ol_url;
            break;
          }
          
          if (strlen($image_contents) < 1000) {
            no_cover($isbn, $cover_url);
          }
          else {
            // Save the image file.
            \Drupal::service('file_system')->saveData($image_contents, $uri, FileSystemInterface::EXISTS_REPLACE);
            
            // Create and save the File entity.
            $file = File::create(['uri' => $uri]);
            $file->setPermanent();
            $file->save();
            
            // Reference the file in the cover_image field.
            $entity->set('cover_image', [
              'target_id' => $file->id(),
              'alt' => 'Cover image for ISBN ' . $isbn,
            ]);          

            save_reference($entity, $build);
            \Drupal::logger('nbbib_cover_import')->notice("Fetched cover image from: $cover_url");
          }
        }
        
        if (isset($file)) {
          $entity->setCoverMissing(NULL);
          $entity->save();
          break;
        }
        else {
          $entity->setCoverMissing($month);
          $entity->save();
        }
      }
    }
    
    if (!isset($file)) {
      $entity->setCoverMissing($month);
      $entity->save();
      $isbn = $matches ? $isbn : 'N/A';
      no_cover($isbn, 'N/A');
    }
  }
}

function no_cover($isbn, $cover_url) {
  \Drupal::logger('nbbib_cover_import')->notice(
    'Failed to fetch cover image for ISBN: @isbn from URL: @url',
    ['@isbn' => $isbn, '@url' => $cover_url]
  );
}

function save_reference(&$entity, &$build) {
  // Save reference entity.
  $entity->save();
  // Force-clear render array cache.
  $build['#cache']['max-age'] = 0;
  \Drupal::service('page_cache_kill_switch')->trigger();
  // Reload page to update image on entity view.
  header("Refresh:0");    
}

function filter_isbn($isbn_in) {
    // Split the string on commas and trim whitespace.
    $parts = array_map('trim', explode(',', $isbn_in));
    // Filter for 10 or 13 digit numbers only.
    $filtered = array_filter($parts, function($item) {
        return preg_match('/^\d{10}$|^\d{13}$/', $item);
    });
    // Reindex array and return.
    return array_values($filtered);
}

/**
 * Dump item to screen.
 *
 * @param string $label
 *   A label for identification.
 * @param mixed $item
 *   The item to dump.
 */
function sd($label = '', $item = NULL) {
  $label = strtoupper($label);
  dump($label);
  dump($item);
}