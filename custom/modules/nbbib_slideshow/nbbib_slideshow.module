<?php

use Drupal\views\ViewExecutable;

/**
 * Implements hook_views_pre_render().
 */
function nbbib_slideshow_views_pre_render(ViewExecutable $view) {
  // Target this particular view/display (replace with real ids).
  if ($view->id() === 'nbbib_slideshow' && $view->current_display === 'block_1') {
    if (isset($view->element) && is_array($view->element)) {
      // Attach the swiper library.
      $view->element['#attached']['library'][] = 'nbbib_slideshow/swiper';

      // Ensure attributes exist and add the swiper container class we look for in JS.
      if (!isset($view->element['#attributes'])) {
        $view->element['#attributes'] = [];
      }
      if (!isset($view->element['#attributes']['class'])) {
        $view->element['#attributes']['class'] = [];
      }

      // Add a unique class to scope the swiper for this view instance.
      // If you have multiple instances and need unique IDs, you can also generate one here.
      $view->element['#attributes']['class'][] = 'nbbib-swiper';

      // Options to pass to JS (enable fade and navigation).
      $options = [
        // transition speed in ms (integer).
        'speed' => 4000,
        // autoplay as an object with delay in ms.
        'autoplay' => [
          'delay' => 1,
          'disableOnInteraction' => FALSE,
          'stopOnLastSlide' => FALSE,
          'pauseOnMouseEnter' => TRUE,
        ],
        'effect' => 'slide',
        // Show pagination? (boolean or object if you need a selector)
        'pagination' => FALSE,
        // Disable navigation.
        'navigation' => FALSE,
        'slidesPerView' => 4,
        // Loop.
        'loop' => TRUE,
        // Breakpoints.
        'breakpoints' => [
          // When window width is >= 991px
          '991' => [
            'slidesPerView' => 6,
          ],
        ],
      ];

      $view->element['#attributes']['data-swiper-options'] = json_encode($options);
    }
  }
}