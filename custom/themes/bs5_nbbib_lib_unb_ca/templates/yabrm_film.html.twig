{#
/**
 * @file yabrm_film.html.twig
 * Default theme implementation to present Film reference data.
 *
 * This template is used when viewing Film reference pages.
 *
 *
 * Available variables:
 * - content: A list of content items. Use 'content' to print all content, or
 * - attributes: HTML attributes for the container element.
 *
 * @see template_preprocess_yabrm_film()
 *
 * @ingroup themeable
 */
#}
<div{{ attributes.addClass('yabrm-reference', 'yabrm-film', 'contrib-layout') }}>
  {% if content %}
    <div class="container">
      <div class="row">
        <ul id="ref-contribs">
          {% if content.contribs_all %}
            {% for contrib in content.contribs_all %}
              {% if contrib.display_name == "Anonymous" %}
                <li>[Anonymous]</li>
              {% else %}
                <li><a href="/yabrm/yabrm_contributor/{{ contrib.cid }}">
                {{ contrib.display_name ~ ' (' ~ contrib.role ~ ')' }}
                </a></li>
              {% endif %}

            {% endfor %}
          {% endif %}
        </ul>
      </div>
      <div class="row">
        <div id="ref-body" class="col-sm-8">
          <h2>Publication Details</h2>
          <div id="ref-details" class="container">
            <div id="ref-type" class="row">
              <div class="col-sm-6">Item Type</div>
              <div class="col-sm-6">Film</div>
            </div>
            {% if content.publisher|field_value %}
              <div id="ref-publisher" class="row">
                <div class="col-sm-6">Publisher</div>
                <div class="col-sm-6">{{ content.publisher|field_value }}</div>
              </div>
            {% endif %}
            {% if content.nb_imprint|field_value %}
              <div id="ref-nb-imprint" class="row">
                <div class="col-sm-6">NB Imprint</div>
                <div class="col-sm-6">{{ content.nb_imprint|field_value }}</div>
              </div>
            {% endif %}
            {% if content.language|field_value %}

              <div id="ref-language" class="row">
                <div class="col-sm-6">Language(s)</div>

                <div class="col-sm-6">
                  {%- for language in content.lang_names -%}
                    {%- if not loop.first -%}
                      {{ ', ' }}
                    {%- endif -%}

                    {{ language }}
                  {%- endfor -%}
                </div>
              </div>
            {% endif %}
            {% if content.running_time|field_value %}
              <div id="ref-running-time" class="row">
                <div class="col-sm-6">Running Time</div>
                <div class="col-sm-6">{{ content.running_time|field_value }}</div>
              </div>
            {% endif %}
            {% if content.distributor|field_value %}
              <div id="ref-distributor" class="row">
                <div class="col-sm-6">Distributor</div>
                <div class="col-sm-6">{{ content.distributor|field_value }}</div>
              </div>
            {% endif %}
            {% if content.performers|field_value %}
              <div id="ref-performers" class="row">
                <div class="col-sm-6">Performers</div>
                <div class="col-sm-6">{{ content.performers|field_value }}</div>
              </div>
            {% endif %}
            {% if content.release|field_value %}
              <div id="ref-release" class="row">
                <div class="col-sm-6">Release Year</div>
                <div class="col-sm-6">{{ content.released|field_value }}</div>
              </div>
            {% endif %}
            {% if content.film_format|field_value %}
              <div id="ref-film-format" class="row">
                <div class="col-sm-6">Format</div>
                <div class="col-sm-6">{{ content.film_format|field_value }}</div>
              </div>
            {% endif %}
            {% if content.genre|field_value %}
              <div id="ref-genre" class="row">
                <div class="col-sm-6">Genre</div>
                <div class="col-sm-6">{{ content.genre|field_value }}</div>
              </div>
            {% endif %}
          </div>

          {% if content.abstract_note|field_value
            or content.num_pages|field_value
            or content.physical_description|field_value %}
            <div id="ref-description">

              <b>Description</b>

              {% if content.abstract_note|field_value %}
                <div>
                  {{ content.abstract_note|field_value }}
                </div>
              {% endif %}

              {% if content.physical_description|field_value
              or content.num_pages|field_value %}
                <p>
                  <span id="ref-physical">
                      {{ "Physical Description: " }}

                      {%- if content.num_pages|field_value[0]['#context']['value'] -%}
                        {%- set pages = content.num_pages|field_value[0]['#context']['value'] -%}
                          {%- if pages == 'n. pag.' -%}
                            {{- pages ~ " " -}}
                          {% else %}
                            {{- pages ~ " pp. "-}}
                          {%- endif -%}
                      {%- endif -%}

                      {%- set pass_tags = '<br><h2><h3><h4><h5><h6><a><cite><blockquote><code><ul><ol><li><dl><dt><dd><sup><sub><img><table><caption><tbody><thead><tfoot><th><td><tr><div><small><span><strong><em><pre><s><hr>' %}
                      
                      {{- content.physical_description|field_value[0]['#text']|striptags(pass_tags)|raw -}}
                  </span>
                </p>
              {% endif %}

            </div>
          {% else %}
            <div id="ref-description"></div>
          {% endif %}
          {% if content.notes|field_value %}
            <div id="ref-notes">
              <b>Notes</b>

              <div>
                {{ content.notes|field_value }}
              </div>

            </div>
          {% endif %}

          {%- if content.topics|field_value -%}
            <div id="ref-topics">
              <b>Topics: </b>

              <span>
                {%- for topic in content.topics|field_value -%}
                  {%- set tname = topic['#options']['entity'].name() -%}
                  {%- set tid = topic['#options']['entity'].id() -%}

                  {%- if not loop.first -%}
                    {{- ", " -}}
                  {%- endif -%}

                  <a href ="/bibliography?f[0]=topic_names_string:{{ tname }}">
                    {{- tname -}}
                  </a>
                {%- endfor -%}
              </span>
            </div>
          {%- endif -%}

          {%- if content.collections|field_value -%}
            <div id="ref-collections">
              <b>Collections: </b>
              <ul>
                {%- for collection in content.collections|field_value -%}
                  <li>{{ collection }}</li>
                {%- endfor -%}
              </ul>

            </div>
          {%- endif -%}        
        </div>

        <div id="ref-picture" class="col-sm-4">
          <div id="ref-cite">
            <a data-dialog-options="{&quot;width&quot;:500}" data-dialog-type="modal" href="/cite/film/{{ content.id }}" id="cite-open" class="use-ajax btn btn-secondary btn-sm fw-normal lh-lg float-end">
              Cite this film
            </a>
          </div>
          {% if content.cover_image|field_value %}
            {{ content.cover_image|field_value }}
          {% endif %}

          {% if content.archives|field_value or content.url|field_value %}
            <div id="ref-copies">
              <b>Copies</b>
              <div>
                <ul>
                  {% for archive in content.archives %}
                    <li>{{ archive }}</li>
                  {% endfor %}

                  {% set urls = content.url %}
                  
                  {% for url in content.url|field_value %}
                    <li>{{ url }}</li>
                  {% endfor %}
                </ul>
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}
</div>
